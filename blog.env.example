# Optional for Compose: copy to blog.env and chmod 600 blog.env.
BLOG_SITE_URL=https://ominicorp.com
# Use a long random password (at least 16 characters); blank disables login.
BLOG_ADMIN_PASSWORD=
# Long random bearer token (at least 32 characters); blank disables /mcp.
BLOG_MCP_TOKEN=
# Optional OpenAI-compatible provider key and HTTP(S) forward proxy URL.
BLOG_AI_KEY=
BLOG_PROXY_URL=
# Set 0 before first startup to omit sample articles.
BLOG_SEED=1
# Use 0 only for local HTTP development. Secure is the production default.
BLOG_COOKIE_SECURE=1
