# Copy to smtp.env and limit file access (chmod 600 smtp.env). Leave SMTP_HOST blank to disable both forms.
# Use raw values (no quotes) for Compose; keep credentials out of Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
PUBLIC_SITE_URL=https://ominicorp.com
